// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String      @id // Supabase Auth User ID (UUID)
  email                  String      @unique
  name                   String?
  avatar                 String?
  passwordChangedAt      DateTime? // Track when password was last changed
  passwordReminderSentAt DateTime? // Track last reminder sent
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  pages                  Page[]
  tags                   Tag[]
  sharedPages            PageShare[] @relation("SharedWith")
  comments               Comment[]

  @@map("users")
}

enum PageMode {
  TRADITIONAL // Centralized, like Notion
  SECURE // Decentralized, encrypted with Walrus + Seal
}

model Page {
  id              String      @id @default(cuid())
  title           String      @default("Untitled")
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode            PageMode    @default(TRADITIONAL)
  blocks          Block[]
  pageTags        PageTag[]
  shares          PageShare[]
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  // Secure mode fields
  storageLocation String? // Walrus CID
  policyId        String? // Seal policy ID
  expiryDate      DateTime? // Storage expiry date
  storageCost     String? // Storage cost in WAL
  epochs          Int? // Number of epochs (14 days each)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([title])
  @@index([userId, isDeleted])
  @@index([mode])
  @@map("pages")
}

model Block {
  id        String    @id @default(cuid())
  type      BlockType
  content   Json
  position  Int
  pageId    String
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  comments  Comment[]
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([pageId])
  @@index([pageId, isDeleted])
  @@map("blocks")
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageTags  PageTag[]
  createdAt DateTime  @default(now())

  @@unique([name, userId])
  @@index([userId])
  @@map("tags")
}

model PageTag {
  pageId    String
  tagId     String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([pageId, tagId])
  @@index([pageId])
  @@index([tagId])
  @@map("page_tags")
}

model PageShare {
  id         String     @id @default(cuid())
  pageId     String
  sharedWith String // User ID
  permission Permission
  page       Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user       User       @relation("SharedWith", fields: [sharedWith], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([pageId, sharedWith])
  @@index([pageId])
  @@index([sharedWith])
  @@map("page_shares")
}

enum Permission {
  VIEW
  EDIT
  COMMENT
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  blockId   String
  userId    String
  parentId  String? // For threaded comments
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  block     Block     @relation(fields: [blockId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([blockId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

enum BlockType {
  TEXT
  HEADING
  CHECKLIST
  IMAGE
  FILE
}
